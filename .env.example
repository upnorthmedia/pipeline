# Copy to `.env` at the repo root and fill in. There is exactly one env file,
# and four things read it:
#   - `web/next.config.ts`, at import time, so `pnpm -C web dev` and
#     `pnpm -C web build` need no sourcing
#   - `web/vitest.config.ts`, so `pnpm -C web test` finds the database
#   - `docker compose`, through `env_file: .env` on the web and worker services
#   - the Mastra CLI, but only when told: `mastra dev --env ../.env`, which is
#     what `pnpm -C web studio` does

# Host port bindings for the Docker services. Change these when another project
# already owns the default port; the container-internal ports never change.
# Whatever POSTGRES_HOST_PORT is set to must also appear in DATABASE_URL_SYNC.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# --- Required ---

# Posts, settings, links, BetterAuth tables and Mastra run state, all one
# database. `web/src/lib/auth.ts` reads this exact name, so a DATABASE_URL
# alone is not enough.
DATABASE_URL_SYNC=postgresql://pipeline:pipeline@localhost:5433/content_pipeline

# The Mastra event bus (Redis Streams) and SSE fan-out. `web/src/mastra/index.ts`
# throws at import without it.
REDIS_URL=redis://localhost:6379

# Fernet key for the encrypted provider credentials in the `settings` table.
# This is not a fresh secret: a different value decrypts nothing and every
# stage loses its API keys. Generate a new one only for a new database, with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WP_ENCRYPTION_KEY=

# BetterAuth. It warns about a missing secret in development and throws under
# NODE_ENV=production, so a deployed image without it fails on the first
# request. Without a base URL it builds callback and verification links
# against a guess.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Optional ---

# Read by `web/src/lib/auth-client.ts` and therefore inlined by `next build`,
# not read at runtime. Unset leaves the browser client on http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Filesystem locations. All three have defaults that are correct when the app
# runs from `web/`, and all three are set explicitly by the compose worker
# service, because the Mastra worker bundle runs with its own output directory
# as the cwd: a missing RULES_DIR silently strips each stage's rule file out of
# its prompt, and a missing TEXTSTAT_DATA_DIR kills the `edit` stage.
# RULES_DIR=./rules
# MEDIA_DIR=./media
# TEXTSTAT_DATA_DIR=./web/src/mastra/textstat/data

# Billing and transactional email. Each falls back to a mock value in code, so
# the app boots without them; the verification email is only sent under
# NODE_ENV=production.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Provider API keys ---
#
# In the running app these are NOT environment variables. They live encrypted
# in the `settings` table (key `api_keys`), are managed from the settings page,
# and are decrypted with WP_ENCRYPTION_KEY. The three below are read only by
# the live provider smoke tests in `pnpm -C web test`, which skip when unset.
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
#
# The one Gemini test that bills a real image (about $0.13 and 14s on
# gemini-3-pro-image) also needs this set to run at all.
# GEMINI_IMAGE_QUOTA=1
