# Host port bindings for the Docker services. Change these when another project
# already owns the default port; the container-internal ports never change.
# Whatever POSTGRES_HOST_PORT is set to must also appear in the URLs below.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# Database
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5433/content_pipeline
DATABASE_URL_SYNC=postgresql://pipeline:pipeline@localhost:5433/content_pipeline
# Used by pytest; defaults to the URL below when unset.
TEST_DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5433/content_pipeline_test

# BetterAuth. Without a base URL BetterAuth warns on every boot and builds
# callback and verification links against a guess.
BETTER_AUTH_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# LLM API Keys
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxx
GEMINI_API_KEY=AI-xxxxxxxxxxxx

# Worker
WORKER_MAX_JOBS=3
